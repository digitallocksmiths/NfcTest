// !TestName: ReadLog
//
//  Tests Read Log (9016 P1 00 00): which record counts it accepts and what
//  it returns. (ISO case checks are in 07_CommandStructure; the FIFO
//  behaviour of Update Log is in 10_LogUpdateCommit.)
//
//  Response:  the newest P1 records, newest first, 30 bytes (48 decimal)
//             each, then 9000. P1 = 1..5, P2 = 00, otherwise 6A86.
//  The log has no seal to hide, so the response is the same whether the
//  card is authenticated or not.
//
//  Setup: CREATE_IPE on slot E (as 06_ReadAndUpdate) to get the log
//     password. Read the 5 records as found (OrigLog).
//  A: Not authenticated:
//       P1 = 1..5: P1 x 30 bytes, and always the first P1 of the 5 records;
//       P1 = 00 and every P1 from 06 to FF: 6A86;
//       every P2 from 01 to FF: 6A86;
//       none of these reads changes the log.
//  B: Authenticated: the same reads give the same data. Then write 5
//     records in the session; after each one, every P1 = 1..5 read shows
//     it at the head and the older ones after it. Commit.
//  C: After commit, not authenticated: every P1 = 1..5 read shows the 5
//     records committed in B, newest first.
//  D: Write the original 5 records back, oldest first, and commit.
//
//  Prerequisite:   Card on Reader A.
//                  ISAM in Reader B.
//
//  If the test stops part way, the log is left with test records. The
//  original is printed at the start (OrigLog).
//

// ---- Status words ---------------------------------------------------
var SW_OK     = 9000;
var SW_P1P2   = 6A86;

// ---- Variables used by Authenticate.Inc, Commit.Inc & LogUpdate.Inc ---
var CardAid    = @Itso.Aid;
var CardSelect = 00A40400 CardAid.Length CardAid;
var HashAcc;
var Hash;
var Sig;
var CmProof;
var IsamProof;
var RaResp;
var RaFci;
var Ra6F;
var RaA5;
var RaShell;
var RaDir;
var RaChal;
var RaPUid;
var RaSUid;
var RaKas;
var RaBody;
var RaIsam;
var RaMedia;

var Tx;
var Rx;

var LogPwd;                                                           // sector password for the log (slot E)
var Rec;                                                              // the record being written
u8  Len      = 0;
var Model;                                                            // expected 5 records (F0 bytes), newest first
u8  Mark     = 0;

var Zeros    = 00;                                                    // 30 bytes of 00 (LogUpdate.Inc pads with these)
u8  Pb       = 0;
for (Pb = 1; Pb < 30; Pb++) {
    Zeros = Zeros 00;
}
var Pattern  = 01;                                                    // 01 02 03 ... 40: record filler, never 00
for (Pb = 2; Pb <= 40; Pb++) {
    Pattern = Pattern Pb;
}

var OrigLog;                                                          // the 5 records as found, restored in D
var OpenLog;                                                          // the 5 records read before authentication
var Tmp;
u8  n        = 0;
u8  r        = 0;
u8  k        = 0;
u8  P        = 0;

// ---- Log creation, as 06_ReadAndUpdate --------------------------------
var LogE_Orphan = 7F80000000;                                         // Orphan entry for the seal
var IsamLog     = 1C0400FCC7A29E80009B0000CA000D5222000001CA000D522200000000FF000000000000;
u8  ShellE      = 0;


@PrintLn(" ************ Setup: get the log password *****************************");
@Include ("Authenticate.Inc");
ShellE = RaShell[18_d];

Tx = LogE_Orphan IsamLog;
Rx = @ReaderB.Apdu("WSAM LOG", 9040 0002 ((u8)(2 + Tx.length)) ((u16)(Tx.length)) Tx);
@Assert(Rx[¬1..] == SW_OK, "WSAM");
Rx = @ReaderB.Apdu("CREATE_IPE (log)", 9052 ((u8)(ShellE-1)) 00 01 01 00);  // P1 = E - 1
@Assert(Rx[¬1..] == SW_OK, "CREATE_IPE");
LogPwd = Rx[2..9];
Rx = @ReaderB.Apdu("RSAM len", 90420002 02);
@Assert(Rx[¬1..] == SW_OK, "RSAM");
Rx = @ReaderB.Apdu("RSAM body", 90420004 Rx[1]);
@Assert(Rx[¬1..] == SW_OK, "RSAM");

Tx = 9016 0500 00;
Rx = @ReaderA.Apdu("Read 5 Log (as found)", Tx);  HashAcc = @Sha256.Update(HashAcc, Tx);  HashAcc = @Sha256.Update(HashAcc, Rx);
@Assert(Rx[¬1..] == SW_OK, "Read Log");
OrigLog = Rx[..¬2];
@Debug(OrigLog);
Model   = OrigLog;


@PrintLn(" ************ A: Not authenticated ***********************************");
@ReaderA.Reset.cold;
Rx = @ReaderA.Apdu("Media Select", CardSelect);
@Assert(Rx[¬1..] == SW_OK, "Select OK?");

@PrintLn("============ P1 = 1..5");
Rx = @ReaderA.Apdu("Read 5 Log", 9016 0500 00);
@Test(Rx[¬1..] == SW_OK, "Read 5 OK");
OpenLog = Rx[..¬2];
@Test(OpenLog == OrigLog, "Not authenticated: the same 5 records as read in the session");
for (n = 1; n <= 5; n++) {
    Rx = @ReaderA.Apdu("Read " :: n :: " Log", 9016 n 00 00);
    @Test(Rx[¬1..] == SW_OK, "Read " :: n :: " OK");
    @Test(Rx.Length == 30*n + 2, "Read " :: n :: ": " :: n :: " records of 30 bytes");
    @Test(Rx[..¬2] == OpenLog[0..(30*n - 1)], "Read " :: n :: ": the newest " :: n :: " records, newest first");
}

@PrintLn("============ Illegal P1: 00 and 06..FF");
Rx = @ReaderA.Apdu("Read Log P1 00", 9016 0000 00);
@Test(Rx[¬1..] == SW_P1P2, "P1 00 rejected");
for (k = 0; k < FA; k++) {                                            // P1 06..FF. Counting k, so the u8 never wraps
    P = 6 + k;
    Rx = @ReaderA.Apdu("Read Log P1 " :: P, 9016 P 00 00);
    @Test(Rx[¬1..] == SW_P1P2, "P1 " :: P :: " rejected");
}

@PrintLn("============ Illegal P2: 01..FF");
for (k = 0; k < FF; k++) {
    P = 1 + k;
    Rx = @ReaderA.Apdu("Read Log P2 " :: P, 9016 05 P 00);
    @Test(Rx[¬1..] == SW_P1P2, "P2 " :: P :: " rejected");
}

Rx = @ReaderA.Apdu("Read 5 Log (after the rejected reads)", 9016 0500 00);
@Test(Rx[..¬2] == OrigLog, "The rejected reads changed nothing");


@PrintLn(" ************ B: Authenticated ****************************************");
@Include ("Authenticate.Inc");
for (n = 1; n <= 5; n++) {
    Tx = 9016 n 00 00;
    Rx = @ReaderA.Apdu("Read " :: n :: " Log (authenticated)", Tx);  HashAcc = @Sha256.Update(HashAcc, Tx);  HashAcc = @Sha256.Update(HashAcc, Rx);
    @Test(Rx[..¬2] == OpenLog[0..(30*n - 1)], "Authenticated: Read " :: n :: " gives the same as before authentication");
}

@PrintLn("============ Write 5 records, reading after each");
Len = 30;
for (r = 1; r <= 5; r++) {
    Mark = B0 + r;
    Tmp  = Mark Len Pattern;
    Rec  = Tmp[0..(Len-1)];
    @Include ("LogUpdate.Inc");

    for (n = 1; n <= 5; n++) {
        Tx = 9016 n 00 00;
        Rx = @ReaderA.Apdu("Read " :: n :: " Log (after B" :: r :: ")", Tx);  HashAcc = @Sha256.Update(HashAcc, Tx);  HashAcc = @Sha256.Update(HashAcc, Rx);
        @Test(Rx[0..2F] == Rec, "After B" :: r :: ": Read " :: n :: " starts with B" :: r);
        @Test(Rx[..¬2] == Model[0..(30*n - 1)], "After B" :: r :: ": Read " :: n :: " gives the newest " :: n :: " records in order");
    }
}
@Include ("Commit.Inc");


@PrintLn(" ************ C: Committed, not authenticated **************************");
@ReaderA.Reset.cold;
Rx = @ReaderA.Apdu("Media Select", CardSelect);
@Assert(Rx[¬1..] == SW_OK, "Select OK?");
for (n = 1; n <= 5; n++) {
    Rx = @ReaderA.Apdu("Read " :: n :: " Log (committed)", 9016 n 00 00);
    @Test(Rx[..¬2] == Model[0..(30*n - 1)], "Committed: Read " :: n :: " gives the newest " :: n :: " records in order");
    @Test(Rx[(30*(n-1))] == B6 - n, "Committed: record #" :: n :: " is B" :: (6 - n));
}


@PrintLn(" ************ D: Restore the original log ******************************");
@Print("Original : " :: OrigLog);
@Include ("Authenticate.Inc");
Len = 30;
Mark = 00;                                                            // no Mark in restored records: 00 just labels the messages
for (n = 5; n >= 1; n--) {                                            // oldest first, so #1 ends up at the head
    Rec = OrigLog[(30*(n-1))..(30*n - 1)];
    @Include ("LogUpdate.Inc");
}
@Include ("Commit.Inc");

@ReaderA.Reset.cold;
Rx = @ReaderA.Apdu("Media Select", CardSelect);
@Assert(Rx[¬1..] == SW_OK, "Select OK?");
Rx = @ReaderA.Apdu("Read 5 Log (restored)", 9016 0500 00);
@Test(Rx[..¬2] == OrigLog, "Original log restored");

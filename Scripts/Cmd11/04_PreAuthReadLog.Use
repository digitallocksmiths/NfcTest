// !TestName: Pre Authenticate Read.
//
//  What the read commands return before any authentication, on a card
//  as left by 03_CreateIpeSuccess (an IPE and VRG in slot 1 only).
//
//  Selects the card (no reset, no ISAM), then:
//      Read Log  (9016 P1 00 00): P1 = 00 and 06 give 6A86, 01..05 give
//                9000 (the log needs no authentication).
//      Read IPE  (9012 P1 00 00): slot 0 gives 6A86; slot 1 gives 9000
//                with the seal redacted (all FF); slots 2..E-1 give 6A83
//                (no entry); slot E gives 6A86 (beyond the IPEs).
//      Read VRG  (9014 P1 00 00): the same as Read IPE.
//
//  The redacted seal is checked by comparing its two 8 byte halves,
//  which are equal when the seal is all FF.
//
//  Prerequisite:   Card on Reader A, as left by 03 (slot 1 occupied,
//                  every other IPE slot empty). No ISAM needed.
//  Fuller read checks are in 10_ReadIpe, 13_ReadVrg and 17_ReadLog.
//

@PrintLn("Media Select");
var Aid    = @Itso.Aid;
var Select = 00A40400 Aid.Length Aid;
var Fci    = @ReaderA.Apdu(Select);
@Assert(Fci[¬1..] == 9000, "Select OK?");

@PrintLn("Parsing the FCI");          @Debug(Fci);    
var Body_6F      = @Tlv(6F, Fci);        @Debug(Body_6F);
var Body_A5      = @Tlv(A5, Body_6F);    @Debug(Body_A5);
var Shell        = @Tlv(C0, Body_A5);    @Debug(Shell);
var Capabilities = @Tlv(C1, Body_A5);    @Debug(Capabilities);
var Directory    = @Tlv(C2, Body_A5);    @Debug(Directory);
var OidList      = @Tlv(C3, Body_A5);    @Debug(OidList);
var OldCSS       = @Tlv(C4, Body_A5);    @Debug(OldCSS);
var Challenge    = @Tlv(C5, Body_A5);    @Debug(Challenge);
var PseudoUid    = @Tlv(C6, Body_A5);    @Debug(PseudoUid);
var StaticUid    = @Tlv(C7, Body_A5);    @Debug(StaticUid);
var Kas1Kas2     = @Tlv(C8, Body_A5);    @Debug(Kas1Kas2);


u8  ShellE = Shell[18_d];
u8  _bE = 0;

var Res;

@PrintLn("Reading Logs");
Res = @ReaderA.Apdu("Read  0 Log", 9016 0000 00 );
@Test(Res[¬1..] == 6A86, "Read 0 Log was expected to fail");

Res = @ReaderA.Apdu("Read  1 Log", 9016 0100 00 );
@Test(Res[¬1..] == 9000, "Read 1 Log OK");

Res = @ReaderA.Apdu("Read  2 Log", 9016 0200 00 );
@Test(Res[¬1..] == 9000, "Read 2 Log OK");

Res = @ReaderA.Apdu("Read  3 Log", 9016 0300 00 );
@Test(Res[¬1..] == 9000, "Read 3 Log OK");

Res = @ReaderA.Apdu("Read  4 Log", 9016 0400 00 );
@Test(Res[¬1..] == 9000, "Read 4 Log OK");

Res = @ReaderA.Apdu("Read  5 Log", 9016 0500 00 );
@Test(Res[¬1..] == 9000, "Read 5 Log OK");

Res = @ReaderA.Apdu("Read  6 Log", 9016 0600 00 );
@Test(Res[¬1..] == 6A86, "Read 6 Log was expected to fail");

@PrintLn("============ Reading IPEs ===================");
@PrintLn("Only expecting #1 to be populated");

_bE = 0;

Res = @ReaderA.Apdu("Read  Ipe #" :: _bE , 9012 ((u8)_bE) 00 00 );
@Test(Res[¬1..] == 6A86, "Expecting bad P1/P2");
_bE++;

Res = @ReaderA.Apdu("Read  Ipe #" :: _bE , 9012 ((u8)_bE) 00 00 );
@Test(Res[¬1..] == 9000, "Read IPE should clip the seal");
if (Res[¬1..] == 9000) {
    @Test(Res[¬17_d..¬10_d] == Res[¬9..¬2], "Seal should be redacted");
}
//var q1=Res[¬17_d..¬10_d];
//var q2=Res[¬9..¬2];
//@Debug(q1);
//@Debug(q2);
_bE++;

for ( ; _bE<ShellE; _bE++) {
    Res = @ReaderA.Apdu("Read  Ipe #" :: _bE , 9012 ((u8)_bE) 00 00 );
    @Test(Res[¬1..] == 6A83 , "Read IPE be record not found");
}

Res = @ReaderA.Apdu("Read  Ipe #"::_bE, 9012 ((u8)_bE) 00 00 );
@Test(Res[¬1..] == 6A86, "Expecting bad P1/P2");



@PrintLn("============ Reading VRGs ===================");
@PrintLn("Only expecting #1 to be populated");

_bE = 0;

Res = @ReaderA.Apdu("Read  Vrg #" :: _bE , 9014 ((u8)_bE) 00 00 );
@Test(Res[¬1..] == 6A86, "Expecting bad P1/P2");
_bE++;

Res = @ReaderA.Apdu("Read  Vrg #" :: _bE , 9014 ((u8)_bE) 00 00 );
@Test(Res[¬1..] == 9000, "Read VRG should clip the seal");
if (Res[¬1..] == 9000) {
    @Test(Res[¬17_d..¬10_d] == Res[¬9..¬2], "Seal should be redacted");
}
_bE++;

for ( ; _bE<ShellE; _bE++) {
    Res = @ReaderA.Apdu("Read  Vrg #" :: _bE , 9014 ((u8)_bE) 00 00 );
    @Test(Res[¬1..] == 6A83 , "Read VRG be record not found");
}

Res = @ReaderA.Apdu("Read  Vrg #"::_bE, 9014 ((u8)_bE) 00 00 );
@Test(Res[¬1..] == 6A86, "Expecting bad P1/P2");




// !TestName: Generic Authenticate.
//
//  Authenticates the card with the ISAM, ending fully authenticated. Run
//  on its own it is a test; it is also @Included by 02, 03, 05, 06 and
//  07 to open a session.
//
//  Static UID card:
//      Select -> ISAM Begin (shell, static UID, challenge)
//             -> Media Authenticate -> ISAM External Authenticate
//  Pseudo UID card (the Select FCI has a C6 pseudo UID):
//      Select -> ISAM Begin (pseudo shell, pseudo UID, challenge)
//             -> Media Authenticate -> ISAM External Authenticate
//             -> Reselect (now the static FCI: real shell, directory,
//                static UID, new challenge) -> ISAM End
//      then the static steps above against the Reselect FCI.
//
//  Pass:  every step gives 9000; the last (ISAM External Authenticate,
//         the ISAM accepting the card's response) is the @Test.
//
//  Leaves set, for scripts that include it:
//      Fci, Shell, Capabilities, Directory, OidList, OldCSS, Challenge,
//      PseudoUid, StaticUid, Kas1Kas2 (from the static FCI where there
//      is one), Media_Resp, and the card fully authenticated with no
//      exchanges yet in its session hash.
//
//  Prerequisite:   Card on Reader A.
//                  ISAM in Reader B.
//  Running the whole CMD11 set from here: start with an empty card (no
//  IPEs), as 02 and 03 create the IPE in slot 1 that 04..07 expect.
//

@ReaderA.Reset.cold;  // Card
@ReaderB.Reset.cold;  // Isam


var UID = @ReaderA.Uid;

var Resp;

@PrintLn("Isam Password");
Resp = @ReaderB.Apdu(90 18 00 00  10  @Itso.PwdI2F);
@Assert(Resp[¬1..] == 9000, "Isam password OK?");

@PrintLn("Media Select");
var Aid    = @Itso.Aid;
var Select = 00A40400 Aid.Length Aid;
var Fci    = @ReaderA.Apdu(Select);
@Assert(Fci[¬1..] == 9000, "Select OK?");

@PrintLn("Parsing the FCI");             @Debug(Fci);    
var Body_6F      = @Tlv(6F, Fci);        @Debug(Body_6F);
var Body_A5      = @Tlv(A5, Body_6F);    @Debug(Body_A5);
var Shell        = @Tlv(C0, Body_A5);    @Debug(Shell);
var Capabilities = @Tlv(C1, Body_A5);    @Debug(Capabilities);
var Directory    = @Tlv(C2, Body_A5);    @Debug(Directory);
var OidList      = @Tlv(C3, Body_A5);    @Debug(OidList);
var OldCSS       = @Tlv(C4, Body_A5);    @Debug(OldCSS);
var Challenge    = @Tlv(C5, Body_A5);    @Debug(Challenge);
var PseudoUid    = @Tlv(C6, Body_A5);    @Debug(PseudoUid);
var StaticUid    = @Tlv(C7, Body_A5);    @Debug(StaticUid);
var Kas1Kas2     = @Tlv(C8, Body_A5);    @Debug(Kas1Kas2);


if (PseudoUid.Length != 0) {                                            // Did we get a PseudoUID?

    @PrintLn("Isam Begin (Pseudo UID)");
    var Begin_Body = @Itso.DateX Shell PseudoUid Challenge;
    var Begin      = 90 48 00 Kas1Kas2[0] Begin_Body.Length Begin_Body  00;
    var Isam_Chal  = @ReaderB.Apdu(Begin);
    @Assert(Isam_Chal[¬1..] == 9000, "Begin OK?");

    @PrintLn("Media Authenticate (pseudo)");
    var Auth       = 90 10 00 00 (Isam_Chal.Length-2)  Isam_Chal[..¬2]  00;
    var Media_Resp = @ReaderA.Apdu(Auth);
    @Assert(Media_Resp[¬1..] == 9000, "Authenticate OK?");

    @PrintLn("Isam External Authenticate (pseudo)");
    var ExtAuth      = 00 82 00 Kas1Kas2[1] (Media_Resp.Length - 2) Media_Resp[..¬2];
    var ExtAuth_Resp = @ReaderB.Apdu(ExtAuth);
    @Assert(ExtAuth_Resp[¬1..] == 9000, "External Authenticate OK?");

    @PrintLn("Media Reselect");
    var Reselect_Resp = @ReaderA.Apdu(90 22 00 00 00);
    @Assert(Reselect_Resp[¬1..] == 9000, "Reselect OK?");

    @PrintLn("Parsing the reselect FCI");   @Debug(Reselect_Resp ); 
    Body_6F      = @Tlv(6F, Reselect_Resp); @Debug(Body_6F);
    Body_A5      = @Tlv(A5, Body_6F);       @Debug(Body_A5);
    Shell        = @Tlv(C0, Body_A5);       @Debug(Shell);
    Directory    = @Tlv(C2, Body_A5);       @Debug(Directory);
    OidList      = @Tlv(C3, Body_A5);       @Debug(OidList);
    Challenge    = @Tlv(C5, Body_A5);       @Debug(Challenge);
    StaticUid    = @Tlv(C7, Body_A5);       @Debug(StaticUid);
    Kas1Kas2     = @Tlv(C8, Body_A5);       @Debug(Kas1Kas2);

    @PrintLn("Isam End (pseudo session)");
    var End_Resp = @ReaderB.Apdu(90 58 00 00 00);
    @Assert(End_Resp[¬1..] == 9000, "End OK?");

}



@PrintLn("Isam Begin - true UID & Shell");
var Begin_Body = @Itso.DateX Shell StaticUid Challenge;
var Begin      = 90 48 00 Kas1Kas2[0] Begin_Body.Length Begin_Body  00;
var Isam_Chal  = @ReaderB.Apdu(Begin);
@Assert(Isam_Chal[¬1..] == 9000, "Begin OK?");

@PrintLn("Media Authenticate");
var Auth       = 90 10 00 00 (Isam_Chal.Length-2)  Isam_Chal[..¬2] 00;
var Media_Resp = @ReaderA.Apdu(Auth);
@Assert(Media_Resp[¬1..] == 9000, "Authenticate OK?");

@PrintLn("Isam External Authenticate");
var ExtAuth      = 00 82 00 Kas1Kas2[1] (Media_Resp.Length - 2) Media_Resp[..¬2];
var ExtAuth_Resp = @ReaderB.Apdu(ExtAuth);
@Test(ExtAuth_Resp[¬1..] == 9000, "External Authenticate OK?");

@Debug;
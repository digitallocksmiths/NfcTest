//  @ResetA.cold;


var Wibble = 80F1234C;
var x      = 0;


@Print("");
@Print("=============================");
@Print("Right Shift Signed");
@Print("=============================");

for (x = 0; x <= 20; x++) {
   @Print( Wibble >>>  x);
}


@Print("");
@Print("=============================");
@Print("Right Shift Unsigned");
@Print("=============================");

for (x = 0; x <= 20; x++) {
   @Print( Wibble >>  x);
}


@Print("");
@Print("=============================");
@Print("Left Shift");
@Print("=============================");

for (x = 0; x <= 20; x+=1) {
   @Print( Wibble <<  x);
}


@Print("");
@Print("=============================");
@Print("Rotate Left");
@Print("=============================");

for (x = 0; x <= 20; x+=1) {
   @Print( Wibble <-<  x);
}


@Print("");
@Print("=============================");
@Print("Rotate Right");
@Print("=============================");

for (x = 0; x <= 20; x+=1) {
   @Print( Wibble >->  x);
}

@Print( "" );

var foo = 1234567;
@Print( foo );
foo <-<= 1;
@Print( foo );
foo >->= 2;
@Print( foo );
foo <-<= 1;
@Print( foo );



